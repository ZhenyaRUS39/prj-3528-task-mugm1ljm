{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "chore", "docs", "refactor", "test", "perf", "ci", "build", "style", "revert"]
    ],
    "subject-case": [2, "never", ["sentence-case", "start-case", "pascal-case"]],
    "header-max-length": [2, "always", 100]
  }
}
