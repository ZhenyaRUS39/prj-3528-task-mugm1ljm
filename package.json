{
  "name": "prj-3528-task-mugm1ljm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 + TypeScript + Vite — admin/routing skeleton with CI.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{vue,ts,tsx,js,jsx,json,md,css,scss,html}\"",
    "format:check": "prettier --check \"**/*.{vue,ts,tsx,js,jsx,json,md,css,scss,html}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-config-prettier": "^9.1.0",
    "vue-eslint-parser": "^9.4.3",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
